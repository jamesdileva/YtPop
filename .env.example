# Copy to .env (gitignored). Never commit real keys.
# Names must carry the YTPOP_ prefix (pydantic-settings env_prefix).
YTPOP_ENV=dev
YTPOP_API_HOST=127.0.0.1
YTPOP_API_PORT=8000
YTPOP_DB_PATH=data/database/mega_clipper.db
# Live discovery (S3). Without it pipelines run on locally seeded data only.
YTPOP_YOUTUBE_API_KEY=
YTPOP_YOUTUBE_QUOTA_DAILY_BUDGET=10000
YTPOP_OLLAMA_HOST=http://127.0.0.1:11434
YTPOP_OLLAMA_EDITOR_MODEL=qwen3.5:9b
# Research-only default: publishing stays blocked until human review flips this.
YTPOP_DEMO_MODE=true
# 24/7 background scheduler (15m scores / 30m analysis drain / 60m cluster).
YTPOP_SCHEDULER=false
