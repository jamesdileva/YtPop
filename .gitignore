# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

# Node / Electron
node_modules/
dist/
out/
*.log
release/
test-results/
playwright-report/
# PyInstaller freeze of the packaged backend (rebuilt by npm run pack:backend)
apps/api/dist-frozen/
apps/api/build-frozen/
apps/desktop/electron/main.js
apps/desktop/electron/preload.js
# tsc emits in place (renderer/**, vite.config.ts) — build output, not source
apps/desktop/**/*.js
!apps/desktop/**/*.tsx

# App data (keep dirs, ignore artifacts)
data/database/*.db
data/database/*.sqlite*
data/models/*
!data/models/.gitkeep
data/raw/*
data/media/*
data/transcripts/*
data/clips/*
data/episodes/*
data/renders/*
data/thumbnails/*
data/logs/*
!data/**/.gitkeep

# Build / OS
.DS_Store
Thumbs.db
