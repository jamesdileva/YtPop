{
  "name": "@ytpop/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "electron:dev": "tsc -p electron/tsconfig.json && electron electron/main.js",
    "test:e2e": "playwright test",
    "dist": "npm run build && tsc -p electron/tsconfig.json && electron-builder --dir",
    "dist:win": "npm run build && tsc -p electron/tsconfig.json && electron-builder --win nsis"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "dotenv": "^9.0.2",
    "electron": "31.7.7",
    "electron-builder": "^24.13.3",
    "jsdom": "^24.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "build": {
    "appId": "com.ytpop.app",
    "productName": "YtPop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.js",
      "electron/preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../apps/api",
        "to": "api",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/.pytest_cache/**",
          "!**/*.pyc",
          "!dist-frozen/**",
          "!build-frozen/**"
        ]
      },
      {
        "from": "../../configs",
        "to": "configs"
      },
      {
        "from": "../../apps/api/dist-frozen/api-backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        "dir",
        "nsis"
      ]
    }
  }
}
